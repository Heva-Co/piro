<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:40px 0;">
    <tr><td align="center">
      <table width="560" cellpadding="0" cellspacing="0" style="background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.1);">
        <tr><td style="background:#18181b;padding:24px 32px;">
          <span style="color:#fff;font-size:20px;font-weight:700;">Piro</span>
        </td></tr>
        <tr><td style="padding:32px;">
          <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;">
            <tr>
              <td style="background:{{ severity_bg }};border-radius:6px;padding:6px 12px;" align="left">
                <span style="color:{{ severity_fg }};font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;">{{ status }}</span>
              </td>
            </tr>
          </table>

          <h1 style="margin:0 0 4px;font-size:22px;font-weight:600;color:#18181b;">{{ check }}</h1>
          {{- if service }}
          <p style="margin:0 0 20px;font-size:14px;color:#71717a;">{{ service }}</p>
          {{- end }}

          {{- if description }}
          <p style="margin:0 0 24px;font-size:15px;color:#3f3f46;line-height:1.6;">{{ description }}</p>
          {{- end }}

          <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px;background:#f4f4f5;border-radius:8px;">
            {{- if current_status }}
            <tr>
              <td style="padding:10px 16px;font-size:13px;color:#71717a;width:120px;">Status</td>
              <td style="padding:10px 16px;font-size:13px;color:#18181b;font-weight:500;">{{ current_status }}</td>
            </tr>
            {{- end }}
            {{- if value }}
            <tr>
              <td style="padding:10px 16px;font-size:13px;color:#71717a;">Observed</td>
              <td style="padding:10px 16px;font-size:13px;color:#18181b;font-weight:500;">{{ value }}</td>
            </tr>
            {{- end }}
            {{- if source }}
            <tr>
              <td style="padding:10px 16px;font-size:13px;color:#71717a;">Source</td>
              <td style="padding:10px 16px;font-size:13px;color:#18181b;font-weight:500;">{{ source }}</td>
            </tr>
            {{- end }}
            {{- if fired_at }}
            <tr>
              <td style="padding:10px 16px;font-size:13px;color:#71717a;">Fired at</td>
              <td style="padding:10px 16px;font-size:13px;color:#18181b;font-weight:500;">{{ fired_at }}</td>
            </tr>
            {{- end }}
          </table>

          {{- if url }}
          <a href="{{ url }}" style="display:inline-block;padding:12px 24px;background:#18181b;color:#fff;text-decoration:none;border-radius:6px;font-size:15px;font-weight:500;">
            View in Piro
          </a>
          {{- end }}

          <hr style="margin:24px 0;border:none;border-top:1px solid #e4e4e7;">
          <p style="margin:0;font-size:12px;color:#a1a1aa;">Piro</p>
        </td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
