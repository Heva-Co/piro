<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piro.Integrations.Abstractions\Piro.Integrations.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FCM (Android) via the official Firebase Admin SDK; APNs (iOS) via a direct HTTP/2 request with a
         hand-signed ES256 provider JWT (System.Security.Cryptography), so no JWT library is needed. -->
    <PackageReference Include="FirebaseAdmin" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exposes the relay's internal URL-derivation helper to unit tests. -->
    <InternalsVisibleTo Include="Piro.UnitTests" />
  </ItemGroup>

</Project>
