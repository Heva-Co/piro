{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piro.dev/schema/piro.schema.json",
  "title": "Piro configuration",
  "description": "Services and checks as code. Anything this file does not declare, it does not touch.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Format version. Only 1 is understood."
    },
    "services": {
      "type": "array",
      "description": "The services this file declares.",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
            "description": "Unique identifier. Immutable: renaming it is a delete and a create."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "description": {
            "type": "string",
            "description": "Optional description."
          },
          "is_hidden": {
            "type": "boolean",
            "description": "Exclude this service from the public status page."
          },
          "display_order": {
            "type": "integer",
            "description": "Position on the status page, ascending."
          },
          "default_status": {
            "description": "Status shown before any check has reported.",
            "enum": [
              "NO_DATA",
              "UP",
              "DEGRADED",
              "PARTIALLY_DOWN",
              "DOWN",
              "MAINTENANCE",
              "FAILURE"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slug",
                "name",
                "type",
                "cron"
              ],
              "additionalProperties": false,
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9]\u002B(?:-[a-z0-9]\u002B)*$",
                  "description": "Unique within its service. Immutable."
                },
                "name": {
                  "type": "string",
                  "description": "Display name."
                },
                "description": {
                  "type": "string",
                  "description": "Optional description."
                },
                "type": {
                  "description": "Check type. Immutable: changing it is a delete and a create.",
                  "enum": [
                    "DNS",
                    "GRPC",
                    "HTTP",
                    "Heartbeat",
                    "Ping",
                    "SSL",
                    "Script",
                    "TCP"
                  ]
                },
                "cron": {
                  "type": "string",
                  "description": "Cron expression. Must not run more often than every minute."
                },
                "is_active": {
                  "type": "boolean",
                  "description": "Whether the check runs. Setting false unschedules it."
                },
                "required_worker_tags": {
                  "description": "Worker tags a runner must carry, as key/value pairs.",
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "alert_configs": {
                  "type": "array",
                  "description": "Alert rules, identified by dimension. Declaring this list replaces the check\u0027s rules; omitting it leaves them untouched.",
                  "items": {
                    "type": "object",
                    "required": [
                      "dimension",
                      "alert_value"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "dimension": {
                        "description": "The dimension this rule watches. One rule per dimension.",
                        "enum": [
                          "BodyRuleFailures",
                          "CertExpiry",
                          "FailedNameServers",
                          "Latency",
                          "Status"
                        ]
                      },
                      "alert_value": {
                        "type": "string",
                        "description": "A status name for the Status dimension, otherwise a numeric threshold."
                      },
                      "failure_threshold": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Consecutive failing cycles before firing."
                      },
                      "success_threshold": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Consecutive healthy cycles before resolving."
                      },
                      "min_failing_regions": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Regions that must fail within one cycle."
                      },
                      "description": {
                        "type": "string",
                        "description": "Optional description."
                      },
                      "is_active": {
                        "type": "boolean",
                        "description": "Whether the rule is evaluated."
                      },
                      "severity": {
                        "description": "Severity raised when the rule fires.",
                        "enum": [
                          "Warning",
                          "Critical"
                        ]
                      }
                    }
                  }
                },
                "type_data": {
                  "type": "object",
                  "description": "Type-specific configuration. Its shape depends on \u0060type\u0060."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "DNS"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "host": {
                            "type": "string",
                            "description": "The hostname to resolve.",
                            "default": ""
                          },
                          "recordType": {
                            "type": "string",
                            "enum": [
                              "A",
                              "AAAA",
                              "CNAME",
                              "MX",
                              "TXT",
                              "NS",
                              "PTR"
                            ],
                            "description": "Record type",
                            "default": "A"
                          },
                          "nameServers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "IPs or hostnames to query. Empty = use the system resolver."
                          },
                          "expectedValue": {
                            "type": "string",
                            "description": "Expected record value. Empty = any successful resolution is UP. Applies when recordType is A or AAAA or CNAME or TXT or NS or PTR."
                          },
                          "expectedMxRecords": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "exchange": {
                                  "type": "string",
                                  "description": "Mail server hostname.",
                                  "default": ""
                                },
                                "priority": {
                                  "type": "number",
                                  "description": "Optional. When set, priority must match too."
                                }
                              },
                              "required": [
                                "exchange"
                              ]
                            },
                            "description": "Each entry must be present in the response. Empty = any successful resolution is UP. Applies when recordType is MX."
                          }
                        },
                        "title": "DNS configuration",
                        "required": [
                          "host"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "GRPC"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "host": {
                            "type": "string",
                            "description": "The gRPC server host to connect to.",
                            "default": ""
                          },
                          "port": {
                            "type": "number",
                            "description": "Port",
                            "default": 0
                          },
                          "service": {
                            "type": "string",
                            "description": "The service name to health-check (grpc.health.v1.Health/Check). Empty checks overall server health."
                          },
                          "tls": {
                            "type": "boolean",
                            "description": "Connect over TLS (https). Leave off for a plaintext (h2c) server.",
                            "default": true
                          },
                          "timeout": {
                            "type": "number",
                            "description": "Abort the probe after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          },
                          "timeoutMs": {
                            "type": "number",
                            "description": "Abort the probe after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          }
                        },
                        "title": "gRPC configuration",
                        "required": [
                          "host",
                          "port"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "HTTP"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "The URL to request.",
                            "default": ""
                          },
                          "method": {
                            "type": "string",
                            "enum": [
                              "GET",
                              "POST",
                              "PUT",
                              "PATCH",
                              "DELETE",
                              "HEAD"
                            ],
                            "description": "Method",
                            "default": "GET"
                          },
                          "headers": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            },
                            "description": "Headers sent with the request."
                          },
                          "body": {
                            "type": "string",
                            "description": "Request body, for POST/PUT/PATCH. Applies when method is POST or PUT or PATCH."
                          },
                          "timeout": {
                            "type": "number",
                            "description": "Abort the request after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          },
                          "timeoutMs": {
                            "type": "number",
                            "description": "Abort the request after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          },
                          "followRedirects": {
                            "type": "boolean",
                            "description": "Follow redirects",
                            "default": true
                          },
                          "expectedStatusCodes": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "Accepted codes or classes (e.g. 200, 2xx). Empty = any 2xx is UP."
                          },
                          "responseRules": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "enum": [
                                    "contains",
                                    "not_contains",
                                    "regex",
                                    "json_path",
                                    "xml_path"
                                  ],
                                  "description": "Type",
                                  "default": "contains"
                                },
                                "value": {
                                  "type": "string",
                                  "description": "The substring, regex, JSONPath, or XPath expression.",
                                  "default": ""
                                },
                                "expected": {
                                  "type": "string",
                                  "description": "For json_path / xml_path: the expected value at the resolved path."
                                },
                                "degraded": {
                                  "type": "boolean",
                                  "description": "When set, a failure marks the check DEGRADED instead of DOWN.",
                                  "default": false
                                }
                              },
                              "required": [
                                "value"
                              ]
                            },
                            "description": "Assertions on the response body; evaluated in order, first failure wins."
                          }
                        },
                        "title": "HTTP configuration",
                        "required": [
                          "url"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "Heartbeat"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "expectedIntervalSeconds": {
                            "type": "number",
                            "description": "How often the target is expected to ping. A missed ping beyond this \u002B grace marks the check DOWN.",
                            "default": 60
                          },
                          "gracePeriodSeconds": {
                            "type": "number",
                            "description": "Extra slack beyond the expected interval before a missed ping counts as DOWN.",
                            "default": 30
                          }
                        },
                        "title": "Heartbeat configuration"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "Ping"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "host": {
                            "type": "string",
                            "description": "The host to ping.",
                            "default": ""
                          },
                          "timeout": {
                            "type": "number",
                            "description": "Abort the ping after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          },
                          "timeoutMs": {
                            "type": "number",
                            "description": "Abort the ping after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          }
                        },
                        "title": "Ping configuration",
                        "required": [
                          "host"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "SSL"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "host": {
                            "type": "string",
                            "description": "The host whose TLS certificate to check.",
                            "default": ""
                          },
                          "port": {
                            "type": "number",
                            "description": "TLS port. Usually 443.",
                            "default": 443
                          }
                        },
                        "title": "SSL configuration",
                        "required": [
                          "host"
                        ]
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "Script"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "script": {
                            "type": "string",
                            "description": "A JavaScript module exporting check() -\u003E { up, message?, dimensions? }. Use the piro:http module for requests.",
                            "default": "import http from \u0027piro:http\u0027;\n\nexport function check() {\n  const r = http.get(\u0027https://example.com/health\u0027);\n  // Return { up } for a simple up/down check. Add a numeric \u0060dimensions\u0060 bag\n  // (e.g. { Severity: 1 }) and threshold it in an alert config for DEGRADED.\n  return { up: r.statusCode === 200, message: \u0027HTTP \u0027 \u002B r.statusCode };\n}"
                          },
                          "timeout": {
                            "type": "number",
                            "description": "Whole-script wall-clock budget. Must be shorter than the check interval.",
                            "default": 10000
                          },
                          "timeoutMs": {
                            "type": "number",
                            "description": "Whole-script wall-clock budget. Must be shorter than the check interval.",
                            "default": 10000
                          },
                          "maxResponseBytes": {
                            "type": "number",
                            "description": "Cap on any http.get response body (default 1 MiB).",
                            "default": 1048576
                          }
                        },
                        "title": "Script configuration"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "TCP"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "type_data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "host": {
                            "type": "string",
                            "description": "The host to connect to.",
                            "default": ""
                          },
                          "port": {
                            "type": "number",
                            "description": "Port",
                            "default": 0
                          },
                          "timeout": {
                            "type": "number",
                            "description": "Abort the connection after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          },
                          "timeoutMs": {
                            "type": "number",
                            "description": "Abort the connection after this many milliseconds. Must be shorter than the check interval.",
                            "default": 5000
                          }
                        },
                        "title": "TCP configuration",
                        "required": [
                          "host",
                          "port"
                        ]
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}